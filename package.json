{
  "name": "conceptual-atlas",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "python3 scripts/validate.py && tsc -b && vite build && python3 scripts/build.py",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port 3000",
    "test": "python3 -m unittest discover -s tests",
    "validate": "python3 scripts/validate.py",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
